# Compiled/cached files and directories
*.pyc
*.mo
.cache

# Auto-generated or externally managed content
/media
/static_root
/templates/managed_content

# Local configuration
settings_local.py

# Real comics.org dumps are large (GBs) and third-party data: never commit
# them. Keep only the docs and the checksum manifest under dumps/.
dumps/*
!dumps/README.md
!dumps/CHECKSUMS

# Editor temp and config files
*.py~
*.html~
*.css~
*.json~
*swp
.project
.pydevproject
.settings
*.nja
.idea
*.iml
